{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "metamodel.schema.json",
  "title": "Metamodel contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "meta", "layers", "statuses", "metatypes", "valueTypes", "listValueTypes", "types", "universalProperties", "properties", "relations", "fieldExpansion", "validationRules", "settings", "enums"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "required": ["title", "strategy"],
      "properties": {
        "title": { "type": "string" },
        "strategy": { "type": "string" }
      }
    },
    "layers": { "type": "array", "items": { "type": "string", "enum": ["system", "classification", "content"] }, "uniqueItems": true },
    "statuses": { "type": "array", "items": { "type": "string", "enum": ["draft", "accepted", "deprecated"] }, "uniqueItems": true },
    "metatypes": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type_value", "label", "layer", "id"],
        "properties": {
          "type_value": { "type": "string" },
          "label": { "type": "string" },
          "layer": { "type": "string", "enum": ["system", "classification", "content"] },
          "id": { "type": "string", "minLength": 1 }
        }
      }
    },
    "valueTypes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "listValueTypes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "types": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type_value", "label", "extends", "group"],
        "properties": {
          "type_value": { "type": "string" },
          "label": { "type": "string" },
          "extends": { "type": ["string", "null"] },
          "group": { "type": "string" }
        }
      }
    },
    "universalProperties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["property_key", "label", "value_type", "required"],
        "properties": {
          "property_key": { "type": "string" },
          "label": { "type": "string" },
          "value_type": { "type": "string" },
          "required": { "type": "string", "enum": ["always", "conditional", "never"] },
          "computed": { "type": "boolean" },
          "enum_values": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["property_key", "label", "value_type", "required", "applies_to"],
        "properties": {
          "property_key": { "type": "string" },
          "label": { "type": "string" },
          "value_type": { "type": "string" },
          "required": { "type": "string", "enum": ["always", "conditional", "never"] },
          "applies_to": { "type": "array", "items": { "type": "string" } },
          "enum_values": { "type": "array", "items": { "type": "string" } },
          "computed": { "type": "boolean" },
          "trigger": { "type": "boolean" },
          "note": { "type": "string" }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relation_key", "label", "source_type", "target_type", "cardinality"],
        "properties": {
          "relation_key": { "type": "string" },
          "label": { "type": "string" },
          "source_type": { "type": "array", "items": { "type": "string" } },
          "target_type": { "type": "array", "items": { "type": "string" } },
          "cardinality": { "type": "string", "enum": ["0..1", "1..1", "0..*", "1..*"] },
          "inverse_label": { "type": "string" },
          "classification": { "type": "boolean" }
        }
      }
    },
    "fieldExpansion": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "applies_to_type", "trigger_property", "trigger_values", "adds_properties", "adds_relations", "mode"],
        "properties": {
          "id": { "type": "string", "pattern": "^FE-\\d{2}$" },
          "applies_to_type": { "type": "array", "items": { "type": "string" } },
          "trigger_property": { "type": "string" },
          "trigger_values": { "type": "array", "items": { "type": "string" } },
          "adds_properties": { "type": "array", "items": { "type": "string" } },
          "adds_relations": { "type": "array", "items": { "type": "string" } },
          "mode": { "type": "string", "enum": ["union"] }
        }
      }
    },
    "validationRules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_key", "severity", "checks", "applies_to"],
        "properties": {
          "rule_key": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warning"] },
          "checks": { "type": "array", "items": { "type": "string" } },
          "applies_to": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "type", "default"],
        "properties": {
          "key": { "type": "string" },
          "type": { "type": "string", "enum": ["boolean", "number", "string", "enum"] },
          "default": {},
          "values": { "type": "array", "items": {} }
        }
      }
    },
    "enums": {
      "type": "object",
      "additionalProperties": true,
      "required": ["occupation", "imageRoles", "bookFormat", "creationMethod"],
      "properties": {
        "occupation": { "type": "array" },
        "imageRoles": { "type": "array" },
        "bookFormat": { "type": "array" },
        "creationMethod": { "type": "array" }
      }
    }
  }
}
