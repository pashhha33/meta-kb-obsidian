{
  "name": "meta-kb",
  "version": "0.6.0",
  "description": "Obsidian plugin for personal knowledge base metamodel",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node esbuild.test.config.mjs && node --test tests/.tmp/bundle.mjs",
    "check:bundle": "node ../tools/check-bundle.mjs"
  },
  "keywords": [
    "obsidian",
    "metamodel",
    "knowledge-base"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.2",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5"
  }
}
